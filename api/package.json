{
  "name": "financeapp-api",
  "version": "1.0.0",
  "description": "Backend API for FinanceApp (Render + Neon Postgres + R2 + OCR + Gemini AI Parser)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/db/run_migrations.js",
    "test": "node --test src/tests/**/*.test.js",
    "test:walterlens-matrix": "node src/tests/walterlens.matrix.mjs",
    "test:walterlens-soak": "node scripts/walterlens_soak.mjs",
    "seed": "node src/db/seed.js",
    "cleanup:sessions": "node src/jobs/cleanup_sessions.js",
    "replace:categories": "node scripts/replaceCategories.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/s3-request-presigner": "^3.966.0",
    "@google/genai": "^2.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  },
  "allowScripts": {
    "@google/genai@2.18.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
